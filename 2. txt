#!/bin/bash

if [[ $# -ne 1 ]]; then
    echo "Hiba: pontosan 1 paramétert kell megadni (fájl vagy jegyzék neve), de $# darab érkezett." 1>&2
    exit 1
fi

target="$1"

if [[ ! -e "$target" ]]; then
    echo "Hiba: a '$target' elem nem létezik." 1>&2
    exit 1
fi

if [[ -d "$target" ]]; then
    rm -r "$target"
    echo "Jegyzéket törölt: '$target'"
elif [[ -f "$target" ]]; then
    rm "$target"
    echo "Fájlt törölt: '$target'"
else
    echo "Hiba: a '$target' nem szabályos fájl és nem is jegyzék." 1>&2
    exit 1
fi